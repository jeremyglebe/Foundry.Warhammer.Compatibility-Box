{
  "bossbar": {
    "description": "Use WFRP Wounds paths and the compatible stacked-bar configuration."
  },
  "splatter": {
    "description": "Use WFRP Wounds and species for blood effects while preserving custom colors."
  },
  "healthEstimate": {
    "description": "Use WFRP Wounds labels: Unconscious at zero under core rules, Mortal Peril! under Up in Arms, Bloodied at 50%, and Gone to Morr... for the Dead condition. Preserve custom and vehicle tables. Recommend disabling NPCs Just Die only under Up in Arms; leave it alone under core."
  },
  "simple-timekeeping": {
    "description": "Install the standard 400-day Imperial calendar. Keeps world time, events, macros, weather and display preferences. Reload after applying. Pause running clocks during setup and apply the Simple Calendar preset too if using both."
  },
  "foundryvtt-simple-calendar-reborn": {
    "description": "Replace the active calendar with the standard 400-day Imperial calendar at the current Foundry world timestamp. Existing dates may display differently; timestamps and notes are not migrated. Keeps other calendars and note categories. With ST&C enabled, its clock controls advance time and Simple Calendar follows Foundry time in third-party mode with automatic clock speed zero; use ST&C to change dates and advance time. Pause running clocks during setup."
  }
}
