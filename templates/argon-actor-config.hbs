<div>
  <div class="form-group">
    <label>{{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Spells.Label"}}</label>
    <div class="form-fields">
      <select name="flags.enhancedcombathud-wfrp4e.spellVisibility">
        {{#if (eq flags.enhancedcombathud-wfrp4e.spellVisibility "all")}}
          <option value="all" selected>
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Spells.All"}}
          </option>
        {{else}}
          <option value="all">
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Spells.All"}}
          </option>
        {{/if}}
        {{#if (eq flags.enhancedcombathud-wfrp4e.spellVisibility "memorized")}}
          <option value="memorized" selected>
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Spells.Memorized"}}
          </option>
        {{else}}
          <option value="memorized">
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Spells.Memorized"}}
          </option>
        {{/if}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Skills.Label"}}</label>
    <div class="form-fields">
      <select name="flags.enhancedcombathud-wfrp4e.skillVisibility">
        {{#if (eq flags.enhancedcombathud-wfrp4e.skillVisibility "all")}}
          <option value="all" selected>
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Skills.All"}}
          </option>
        {{else}}
          <option value="all">
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Skills.All"}}
          </option>
        {{/if}}
        {{#if (eq flags.enhancedcombathud-wfrp4e.skillVisibility "basic")}}
          <option value="basic" selected>
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Skills.Basic"}}
          </option>
        {{else}}
          <option value="basic">
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Skills.Basic"}}
          </option>
        {{/if}}
        {{#if (eq flags.enhancedcombathud-wfrp4e.skillVisibility "advanced")}}
          <option value="advanced" selected>
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Skills.Advanced"}}
          </option>
        {{else}}
          <option value="advanced">
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Skills.Advanced"}}
          </option>
        {{/if}}
        {{#if (eq flags.enhancedcombathud-wfrp4e.skillVisibility "trained")}}
          <option value="trained" selected>
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Skills.Trained"}}
          </option>
        {{else}}
          <option value="trained">
            {{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.Skills.Trained"}}
          </option>
        {{/if}}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.WeaponSets.Label"}}</label>
    <div class="form-fields">
      <input
        type="checkbox"
        name="flags.enhancedcombathud-wfrp4e.switchEquip"
        {{checked flags.enhancedcombathud-wfrp4e.switchEquip}}
      />
    </div>
    <p class="hint">{{localize "wfrp4e-compatibility-box.Argon.PortraitConfig.WeaponSets.Hint"}}</p>
  </div>
</div>